# Obsidian Atlas — same-origin production (HTTPS automatic with Caddy).
# Adjust root path and domain. Backend: Fastify on 127.0.0.1:3001 (full app: atlas-backend/src/index.ts).
#
# DNS: point both apex and www to this host (A/AAAA to the same IP or ALIAS).
# Caddy requests one certificate that includes both hostnames (SANs).
#
#   sudo caddy run --config /path/to/obsidian-atlas/deploy/Caddyfile
#
# Routes mirror vite.config.ts dev proxy:
#   /api/*  → backend with /api stripped → /v1/... on Fastify
#   /auth/* → backend unchanged
#   /ollama/* → local Ollama (optional; strip /ollama) — remove block if unused

obsidianatlastech.com, www.obsidianatlastech.com {
	root * /var/www/obsidian-atlas/dist
	encode gzip zstd

	# Strip /api prefix (same as Vite: /api/v1/foo → upstream /v1/foo)
	handle_path /api/* {
		reverse_proxy 127.0.0.1:3001
	}

	handle /auth* {
		reverse_proxy 127.0.0.1:3001
	}

	# Optional: same-origin Ollama (matches default OLLAMA_CHAT_URL /ollama/api/chat).
	# If /ollama/* returns 403 while 127.0.0.1:11434 works, Ollama is blocking the public Host/origin.
	# Fix: `sudo systemctl edit ollama` → Environment=OLLAMA_ORIGINS=https://YOURDOMAIN,https://www.YOURDOMAIN,*
	# then `daemon-reload` + `restart ollama`.
	handle_path /ollama/* {
		reverse_proxy 127.0.0.1:11434 {
			header_up Host 127.0.0.1:11434
		}
	}

	handle {
		try_files {path} /index.html
		file_server
	}
}
